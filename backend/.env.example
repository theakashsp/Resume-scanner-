# ==============================================================================
# Resume Analyzer - Backend Environment Configuration Template
# ==============================================================================

# Server & Runtime (Cloud Platforms like Render, Railway, Heroku inject PORT automatically)
HOST=0.0.0.0
PORT=8000
APP_ENV=production

# ------------------------------------------------------------------------------
# AI Integration (Optional - Falls back to local NLP heuristic engine when omitted)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# Live Job Search Option A: Jobvetta API (Recommended - Direct Search & Openings)
# Endpoint: https://api.jobvetta.com/v1/jobs
# ------------------------------------------------------------------------------
JOBVETTA_API_KEY=your_jobvetta_api_key

# ------------------------------------------------------------------------------
# Live Job Search Option B: JSearch via RapidAPI (Optional)
# ------------------------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# ------------------------------------------------------------------------------
# Live Job Search Option C: Adzuna India Jobs (Optional)
# ------------------------------------------------------------------------------
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ------------------------------------------------------------------------------
# CORS & Allowed Domains for Cloud Deployment
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. your Vercel or custom frontend domain)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
# Optional regex to auto-allow Vercel/Netlify preview deployments:
# CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$|^https:\/\/.*\.netlify\.app$

# ------------------------------------------------------------------------------
# Google Firebase (Cloud Firestore & Firebase Cloud Storage - Primary Cloud Stack)
# ------------------------------------------------------------------------------
# 1. Project ID:
# FIREBASE_PROJECT_ID=your-firebase-project-id
#
# 2. Service Account Key (provide either an inline JSON string OR a local file path):
# Option A: Inline JSON string (Recommended for Render, Railway, Cloud Run secrets):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"firebase-adminsdk@..."}
#
# Option B: File path to downloaded serviceAccountKey.json:
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
#
# 3. Firebase Cloud Storage Bucket (for resume & report persistence with V4 signed URLs):
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
#
# ------------------------------------------------------------------------------
# Persistent Database - Relational (Optional alternative: PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
# DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# PDF Parsing & Upload Boundaries (Optional overrides)
# ------------------------------------------------------------------------------
# MAX_PDF_FILE_SIZE_BYTES=10485760  # 10 MB default
# MAX_PDF_PAGES=30                  # 30 pages limit
# MIN_EXTRACTED_CHARS_THRESHOLD=30  # Minimum extractable characters
