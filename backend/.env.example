# ==============================================================================
# Resume Analyzer - Environment Configuration
# ==============================================================================

# AI Integration (Optional - Falls back to local NLP heuristic engine when omitted)
GEMINI_API_KEY=your_gemini_api_key

# Live Job Search Option A: JSearch via RapidAPI (Optional)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Live Job Search Option B: Adzuna India Jobs (Optional)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Security & CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PDF Parsing & Upload Boundaries (Optional overrides)
# MAX_PDF_FILE_SIZE_BYTES=10485760  # 10 MB default
# MAX_PDF_PAGES=30                  # 30 pages limit
# MIN_EXTRACTED_CHARS_THRESHOLD=30  # Minimum extractable characters

