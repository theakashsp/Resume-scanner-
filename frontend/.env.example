# ==============================================================================
# Resume Analyzer - Frontend Environment Configuration Template
# ==============================================================================

# Backend API Base URL
# - In local development: defaults to http://127.0.0.1:8000 when empty
# - When deployed separately (e.g. Frontend on Vercel/Netlify, Backend on Render):
#   Set this in your Vercel/Netlify project settings to your backend cloud URL:
#   REACT_APP_API_URL=https://resume-analyzer-api.onrender.com
# - When deployed together in a single container or unified domain:
#   Leave this blank! The frontend will automatically use same-origin calls.
REACT_APP_API_URL=

# Firebase Client Configuration (Optional - For Frontend Analytics & Client Auth)
# Add your Firebase Web App configuration:
REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
